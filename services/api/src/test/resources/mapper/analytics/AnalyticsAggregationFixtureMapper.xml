<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.promptoptimizer.analytics.support.AnalyticsAggregationFixtureMapper">
    <!-- 只调整本次随机账号；显示名称也是夹具标记，不能按账号主键修改已有用户。 -->
    <update id="setCreatedAt">
        UPDATE user_account SET created_at = #{createdAt}
        WHERE id = #{userId} AND tenant_id = #{tenantId} AND display_name = #{displayName}
    </update>
</mapper>
