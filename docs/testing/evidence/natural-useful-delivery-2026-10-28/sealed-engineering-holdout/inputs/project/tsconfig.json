{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "lib": ["ES2022", "DOM"], "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": false, "noEmit": true, "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
