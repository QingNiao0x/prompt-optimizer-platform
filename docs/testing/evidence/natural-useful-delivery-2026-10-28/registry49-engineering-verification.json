  "implementation": {
    "preparation": "Original scope call also extracts source-checked original requirements. Server assigns r0.. IDs; all original and bound-answer sources use original resolve. No readiness judgment from preparation.",
    "writer": "Full original input remains visible. Returns ID/body quote coverage, sparse replacement/new original requirements, final goal/deliverable/inputReadiness, additions and pending decisions.",
    "provenance": "Original immutable registry retains preparation evidence; replacement must explicitly supply its own original evidence. No automatic evidence merge, no invented body quote or automatic semantic match.",
    "normalization": "Actual domain normalize returns canonical Draft and sparse ID/index/change links. Existing raw body, app safety/permission assembly and assembled body guards run normally.",
    "repair": "49 uses the existing per-phase second attempt only. MissingSources only adapts trusted sourceId hint to new legal fields; no 48 invalid-candidate/diagnostic data.",
    "sharedValidatorChange": "NaturalTaskReview only adds immutable sourceIds accessor; no validation predicate or legacy repair text changed."
  },
  "necessaryProtocolBranches": [
    {
      "branch": "version49 preparation/writer readers",
      "basis": "Separate strict new DTO, preserve old1-48 wire and reject unknown/obsolete fields instead of ignoring them."
    },
    {
      "branch": "server reqId membership/replacement/new ID allocation",
      "basis": "Avoid writer repeating original requirements while rejecting unknown, duplicate or missing references; new IDs are never model-issued."
    },
    {
      "branch": "sparse replacement",
      "basis": "Allow correcting preparation omissions or misunderstandings without forcing wrong prior goal/deliverable or losing explicit answer-source checks."
    },
    {
      "branch": "final readiness from writer",
      "basis": "Preparation does not fix sufficiency or gate BODY; all-conditional/descriptive classification still writes."
    },
    {
      "branch": "MissingSources wording",
      "basis": "Preserve the same safe server ID information under49 preparation/requirementChanges field names; Plan and old hints unchanged."
    }
  ],
