# 默认通过 OpenAI 兼容协议使用 DeepSeek，真实密钥只保存在本地环境或密钥管理服务中。
MODEL_PROVIDER_MODE=openai-compatible
MODEL_PROVIDER_NAME=deepseek
MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
# 逗号分隔的可选模型白名单；TokenHub 示例：
# glm-5.3-flashx,deepseek-v4-pro-0813,kimi-k3,minimax-m3
MODEL_MODELS=
# 同时启用 DeepSeek 与 TokenHub 时设为 true；模型目录会返回 deepseek:model 与 tokenhub:model。
MODEL_MULTI_PROVIDER_ENABLED=false
MODEL_DEFAULT_PROVIDER=deepseek
MODEL_DEEPSEEK_API_KEY=
MODEL_DEEPSEEK_MODELS=deepseek-chat
MODEL_TOKENHUB_API_KEY=
MODEL_TOKENHUB_MODELS=glm-5.3-flashx,deepseek-v4-pro-0813,kimi-k3,minimax-m3
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=3000
MODEL_CONNECT_TIMEOUT=3s
MODEL_READ_TIMEOUT=60s
MODEL_JSON_RESPONSE_FORMAT_ENABLED=true

# 平台所有模型路由共享的在途 HTTP 调用上限；账号限制覆盖整次模型相关请求。
MODEL_CONCURRENCY_GLOBAL_LIMIT=100
MODEL_CONCURRENCY_USER_LIMIT=3
# 生产及多实例使用同一 Redis 和前缀；MEMORY 仅用于本地单实例联调。
MODEL_CONCURRENCY_STORE_MODE=REDIS
MODEL_CONCURRENCY_KEY_PREFIX=prompt-optimizer:model-concurrency

# 可选的语义向量检索。建议优先使用本机 OpenAI Embeddings 兼容服务，避免全文发送到第三方。
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_ENDPOINT=http://localhost:11434/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_BATCH_CHARACTERS=48000
EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_READ_TIMEOUT=45s

# 可选的模型 Map-Reduce 全文摘要。复用上方 MODEL_* 聊天模型和密钥，不需要填写第二份 API Key。
MAP_REDUCE_SUMMARY_ENABLED=false
MAP_REDUCE_MAP_BATCH_SIZE=8
MAP_REDUCE_REDUCE_BATCH_SIZE=24
MAP_REDUCE_MAX_BATCH_CHARACTERS=48000
MAP_REDUCE_INTERMEDIATE_CHARACTERS=1200
MAP_REDUCE_FINAL_CHARACTERS=1800
MAP_REDUCE_MAX_MAP_CALLS=256
MAP_REDUCE_MAX_REDUCE_CALLS=32

# API Key 加密主密钥，必须由运行环境提供，禁止提交到 Git。
API_KEY_ENCRYPTION_SECRET=

# 最小登录认证。密码至少 8 个字符且 UTF-8 不超过 72 字节；写入 BCrypt 哈希后不会被环境变量覆盖。
BOOTSTRAP_USER_EMAIL=demo@local
BOOTSTRAP_USER_PASSWORD=
# local-mock 不使用数据库，必须单独提供符合上述 8 位限制的密码。
LOCAL_AUTH_EMAIL=demo@local
LOCAL_AUTH_PASSWORD=
AUTH_SESSION_TIMEOUT=8h
# 仅在 HTTPS 部署时设为 true；本机 HTTP 联调保持 false。
AUTH_COOKIE_SECURE=false
# 默认 Lax；前端与 API 使用不同域名时，HTTPS 跨站 Session 需要设为 None。
AUTH_COOKIE_SAME_SITE=Lax
# 仅填写受信任的前端 Origin，例如 https://your-site.example.com；本地同源留空。
AUTH_CORS_ALLOWED_ORIGIN=

# 邮箱验证码注册。验证码 HMAC 密钥至少 32 字节，必须随机生成并保存在部署环境中。
EMAIL_REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_SECRET=
# 本地可显式设为 log 并从后端日志读取验证码；公网必须使用 smtp，禁止使用 log。
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM_ADDRESS=
EMAIL_CODE_TTL=5m
EMAIL_CODE_RESEND_INTERVAL=60s
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_EMAIL_HOURLY_LIMIT=5
EMAIL_CODE_IP_HOURLY_LIMIT=20
# 公网或多实例环境保持 true；Redis 不可用时拒绝发码，不降级为分散的进程内限流。
EMAIL_VERIFICATION_REQUIRE_REDIS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=10000
SMTP_WRITE_TIMEOUT_MS=10000

# 阿里云 PNVS：默认关闭，不影响邮箱功能。详见 docs/development/阿里云PNVS短信认证接入.md。
# 以下仅是变量名说明；真实值放后端进程环境，不放 Git、VITE_*、命令行参数或浏览器。
SMS_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
# 每个环境使用不同的 1-11 位字母数字/下划线/连字符前缀；服务端追加用途后缀。
SMS_SCHEME_PREFIX=
# 独立随机业务密钥，至少 32 字节；不得复用 AccessKey 或 EMAIL_VERIFICATION_SECRET。
SMS_VERIFICATION_SECRET=
SMS_ACCOUNT_TEMPLATE=100001
SMS_BINDING_TEMPLATE=100004
SMS_PHONE_HOURLY_LIMIT=5
SMS_IP_HOURLY_LIMIT=20
SMS_ACTOR_HOURLY_LIMIT=5
# 真实短信要求共享 Redis，禁止同时启用 local-sql-debug / P6Spy / 身份Mapper详细日志。
LOGIN_GUARD_REQUIRE_REDIS=true

# 本地 Docker 基础设施。仅用于开发环境，生产环境使用密钥管理服务。
POSTGRES_DB=prompt_optimizer
POSTGRES_USER=prompt_optimizer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
DB_URL=jdbc:postgresql://localhost:5432/prompt_optimizer
DB_USERNAME=prompt_optimizer
DB_PASSWORD=change-me
REDIS_URL=redis://localhost:6379
FLYWAY_ENABLED=true
