# 默认通过 OpenAI 兼容协议使用 DeepSeek，真实密钥只保存在本地环境或密钥管理服务中。
MODEL_PROVIDER_MODE=openai-compatible
MODEL_PROVIDER_NAME=deepseek
MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=3000
MODEL_CONNECT_TIMEOUT=3s
MODEL_READ_TIMEOUT=60s
MODEL_JSON_RESPONSE_FORMAT_ENABLED=true

# 可选的语义向量检索。建议优先使用本机 OpenAI Embeddings 兼容服务，避免全文发送到第三方。
SEMANTIC_RETRIEVAL_ENABLED=false
EMBEDDING_ENDPOINT=http://localhost:11434/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_BATCH_CHARACTERS=48000
EMBEDDING_CONNECT_TIMEOUT=3s
EMBEDDING_READ_TIMEOUT=45s

# API Key 加密主密钥，必须由运行环境提供，禁止提交到 Git。
API_KEY_ENCRYPTION_SECRET=

# 本地 Docker 基础设施。仅用于开发环境，生产环境使用密钥管理服务。
POSTGRES_DB=prompt_optimizer
POSTGRES_USER=prompt_optimizer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
DB_URL=jdbc:postgresql://localhost:5432/prompt_optimizer
DB_USERNAME=prompt_optimizer
DB_PASSWORD=change-me
REDIS_URL=redis://localhost:6379
FLYWAY_ENABLED=true
